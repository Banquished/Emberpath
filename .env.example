POSTGRES_PASSWORD=emberpath_local
POSTGRES_PORT=5432
TEST_POSTGRES_PORT=5433
WEIGHT_API_PORT=8000
# API_PORT is a deprecated fallback for existing Compose callers.
WEB_PORT=5173

# Nutrition-only database; use a unique URL-safe local password before first start.
NUTRITION_POSTGRES_PASSWORD=nutrition_local_change_me
NUTRITION_POSTGRES_PORT=5434
NUTRITION_API_PORT=8001

# Clerk settings; use the same development instance for both backends.
# Only the publishable key is passed to the web build.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
